#ifdef __CCE_KT_TEST__
#define __aicore__
#else
#define __aicore__ [aicore]
#endif

// Dense softmax tile:
// logical shape [B=1, H=1, M=8, N=1024].
// Each row computes softmax(qk_row) across all 1024 columns; no attention scale is applied.
__attribute__((always_inline)) inline [aicore] void attention_softmax_3row_deferbar1024_simd_ub(
    __ubuf__ float *memA,
    __ubuf__ float *memB) {

    __ubuf__ float *memA1 = memA + 1024;
    __ubuf__ float *memB1 = memB + 1024;
    __ubuf__ float *memA2 = memA + 2048;
    __ubuf__ float *memB2 = memB + 2048;
    __ubuf__ float *memBt = memB + 0;

    __VEC_SCOPE__ {
        vector_bool pat_all_b32 = pset_b32(PAT_ALL);
        vector_f32 vec_x;
        vector_f32 vec_x_pair;
        vector_f32 vec_x_2;
        vector_f32 vec_x_3;
        vector_f32 vec_blk_max;
        vector_f32 vec_blk_max_pair;
        vector_f32 vec_blk_max_bcast;
        vector_f32 vec_blk_max_bcast_pair;
        vector_f32 vec_row_max_a;
        vector_f32 vec_row_max_b;
        vector_f32 vec_row_max;
        vector_f32 vec_shift;
        vector_f32 vec_shift_pair;
        vector_f32 vec_shift_2;
        vector_f32 vec_shift_3;
        vector_f32 vec_exp;
        vector_f32 vec_exp_pair;
        vector_f32 vec_exp_2;
        vector_f32 vec_exp_3;
        vector_f32 vec_blk_sum;
        vector_f32 vec_blk_sum_pair;
        vector_f32 vec_blk_sum_2;
        vector_f32 vec_blk_sum_3;
        vector_f32 vec_blk_sum_bcast;
        vector_f32 vec_blk_sum_bcast_pair;
        vector_f32 vec_blk_sum_bcast_2;
        vector_f32 vec_blk_sum_bcast_3;
        vector_f32 vec_row_sum_a;
        vector_f32 vec_row_sum_b;
        vector_f32 vec_row_sum_c;
        vector_f32 vec_row_sum_d;
        vector_f32 vec_row_sum;
        vector_f32 vec_out;
        vector_f32 vec_out_pair;
        vector_f32 vec_out_2;
        vector_align u1;
        for(uint16_t i_batch=0; i_batch <8; i_batch ++)
        {
            vlds(vec_row_max_a, memA, 0, NORM);
            vlds(vec_row_max_b, memA, 64, NORM);
            vlds(vec_x_2, memA, 128, NORM);
            vlds(vec_x_3, memA, 192, NORM);
            #pragma unroll(1)
            for (uint16_t blk = 0; blk < 3; ++blk) {
                vlds(vec_x, memA, 256 * (blk + 1) + i_batch*1024, NORM);
                vlds(vec_x_pair, memA, 256 * (blk + 1) + 64 + i_batch*1024, NORM);
                vlds(vec_blk_max_bcast, memA, 256 * (blk + 1) + 128 + i_batch*1024, NORM);
                vlds(vec_blk_max_bcast_pair, memA, 256 * (blk + 1) + 192 + i_batch*1024, NORM);
                vmax(vec_row_max_a, vec_row_max_a, vec_x, pat_all_b32);
                vmax(vec_row_max_b, vec_row_max_b, vec_x_pair, pat_all_b32);
                vmax(vec_x_2, vec_x_2, vec_blk_max_bcast, pat_all_b32);
                vmax(vec_x_3, vec_x_3, vec_blk_max_bcast_pair, pat_all_b32);
            }
            vmax(vec_row_max_a, vec_row_max_a, vec_row_max_b, pat_all_b32);
            vmax(vec_x_2, vec_x_2, vec_x_3, pat_all_b32);
            vmax(vec_row_max_a, vec_row_max_a, vec_x_2, pat_all_b32);
            vcmax(vec_blk_max, vec_row_max_a, pat_all_b32, MODE_ZEROING);
            vstus(u1, 1, vec_blk_max, memBt, POST_UPDATE);
        }
        vstas(u1, memBt, 0, POST_UPDATE);
        mem_bar(VST_VLD);

        for(uint16_t i_batch=0; i_batch <8; i_batch ++)
        {
            vdup(vec_row_sum_a, 0.0f, pat_all_b32, MODE_ZEROING);
            vdup(vec_row_sum_a, 0.0f, pat_all_b32, MODE_ZEROING);
            #pragma unroll(1)
            for (uint16_t blk = 0; blk < 8; ++blk) {
                vlds(vec_x, memA, 128 * blk + i_batch*1024, NORM);
                vlds(vec_x_pair, memA, 128 * blk + 64 + i_batch*1024, NORM);
                vsub(vec_shift, vec_x, vec_row_max, pat_all_b32);
                vsub(vec_shift_pair, vec_x_pair, vec_row_max, pat_all_b32);
                vexp(vec_exp, vec_shift, pat_all_b32);
                vexp(vec_exp_pair, vec_shift_pair, pat_all_b32);
                vadd(vec_row_sum_a, vec_row_sum_a, vec_exp, pat_all_b32);
                vadd(vec_row_sum_b, vec_row_sum_b, vec_exp_pair, pat_all_b32);
                vsts(vec_exp, memB, 128 * blk, NORM_B32, pat_all_b32);
                vsts(vec_exp_pair, memB, 128 * blk + 64, NORM_B32, pat_all_b32);
            }
            vadd(vec_row_sum_a, vec_row_sum_a, vec_row_sum_b, pat_all_b32);
            vcadd(vec_blk_sum, vec_row_sum_a, pat_all_b32, MODE_ZEROING);
            vstus(u1, 1, vec_blk_sum, memBt, POST_UPDATE);
        }
        vstas(u1, memBt, 0, POST_UPDATE);
        mem_bar(VST_VLD);
        
        vlds(vec_row_sum, memA1, 0, NORM);
        vdup(vec_out, 1.0f, pat_all_b32, MODE_ZEROING);
        vdiv(vec_out, vec_out, vec_row_sum, pat_all_b32);
        vsts(vec_out, memB2, 0, NORM_B32, pat_all_b32);
       
        mem_bar(VST_VLD);
        for(uint16_t i_batch=0; i_batch<8; i_batch ++)
        {
            vlds(vec_out_pair, memA1, 1, BRC_B32, POST_UPDATE);
            for (uint16_t blk = 0; blk < 16; ++blk) {
                vlds(vec_exp, memB, 64 * blk + i_batch*1024, NORM);
                vmul(vec_exp, vec_exp, vec_out, pat_all_b32);
                vsts(vec_exp, memB, 64 * blk + i_batch*1024, NORM_B32, pat_all_b32);
            }
        }
    }
}

extern "C" __global__ __aicore__ void attention_softmax_kernel(
    __gm__ float* __restrict__ input0,
    __gm__ float* __restrict__ input1,
    __gm__ float* __restrict__ output0)
{
    (void)input1;
    __ubuf__ float *ub_data_x_addr_0 = (__ubuf__ float*)get_imm(0x0);
    __ubuf__ float *ub_data_y_addr_0 = (__ubuf__ float*)get_imm(0x10000);

    constexpr int rows = 8;
    constexpr int cols = 1024;
    constexpr int row_bytes = cols * 4;
    constexpr int tile_bytes = rows * row_bytes;

    copy_gm_to_ubuf_align_v2((__ubuf__ float*)ub_data_x_addr_0, (__gm__ float*)input0,
                             0, 1, tile_bytes, 0, 0, 0, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_V, (event_t)0);
    wait_flag(PIPE_MTE2, PIPE_V, (event_t)0);

    attention_softmax_3row_deferbar1024_simd_ub(ub_data_x_addr_0 + 0 * cols, ub_data_y_addr_0 + 0 * cols);
    //attention_softmax_3row_deferbar1024_simd_ub(ub_data_x_addr_0 + 3 * cols, ub_data_y_addr_0 + 3 * cols);
    //attention_softmax_2row_deferbar1024_simd_ub(ub_data_x_addr_0 + 6 * cols, ub_data_y_addr_0 + 6 * cols);

    pipe_barrier(PIPE_ALL);
    copy_ubuf_to_gm_align_v2((__gm__ float*)output0, (__ubuf__ float*)ub_data_y_addr_0,
                             0, 1, tile_bytes, 0, 0, 0);
    pipe_barrier(PIPE_ALL);
}
